# ============================================================
# Multi-chain NEW-PAIR PAPER BOT
# DEXPaprika = discovery
# DexScreener = price tracking
# grammY + telegram-markdown-v2 = Telegram reporting
# ============================================================

MODE=paper

# ------------------------------------------------------------
# DexPaprika discovery
# SDK: dexpaprika-sdk
# Free key is optional. Pro users should set the Pro base URL.
# ------------------------------------------------------------
DEXPAPRIKA_BASE_URL=https://api.dexpaprika.com
DEXPAPRIKA_API_KEY=

# One SDK request per chain per discovery cycle.
# 8 chains x every 40s ~= 12 requests/minute.
# The bot also enforces this per-minute ceiling. Increase it only
# when your DexPaprika plan allows it.
DISCOVERY_INTERVAL_MS=40000
DISCOVERY_LIMIT=30
DEXPAPRIKA_MAX_RPM=14
# Evidence-backed new-pool band: wait below 60s, reject past 120s,
# trade only $15k–$100k liquidity (strongest realized expectancy).
NEW_POOL_MIN_AGE_SEC=60
NEW_POOL_MAX_AGE_SEC=120
MIN_LIQUIDITY_USD=15000
MAX_LIQUIDITY_USD=100000
MIN_VOLUME_24H_USD=1000
MIN_TXNS_24H=5

# Research set: Base off (insufficient sample, 3 trades).
CHAINS=solana,bsc,ethereum,robinhood,arbitrum,avalanche,polygon

# Optional quote-token filter, applied AFTER DexScreener resolves
# the new DEXPaprika pool. Empty = allow any quote token.
# Example: SOL,USDC,USDT,WETH,ETH,BNB,WBNB
QUOTE_SYMBOLS=SOL,USDC,USDT,WETH,ETH,BNB,WBNB

# Optional DEX filter. Empty = allow every DEX.
DEX_IDS=

# ------------------------------------------------------------
# DexScreener price tracking
# Current endpoint budget is 300 requests/minute.
# Only ACTIVE positions are tracked.
# ------------------------------------------------------------
DEXSCREENER_BASE_URL=https://api.dexscreener.com
PRICE_POLL_MS=1000
DEXSCREENER_MAX_RPM=290
DEXSCREENER_PAIR_BATCH_SIZE=20

# ------------------------------------------------------------
# Paper entry
# ------------------------------------------------------------
AUTO_ENTRY=false
POSITION_SIZE_USD=10
INITIAL_BALANCE_USD=10000
MAX_OPEN_POSITIONS=5
MAX_POSITION_AGE_MIN=60

# Pre-entry exitability guard: skip pools where our own paper exit would
# move the price more than this (est. against half the venue liquidity).
# Backstop only — with MIN_LIQUIDITY_USD=15000 and $10 size it never fires.
MAX_ENTRY_IMPACT_PCT=5

# Per-chain size overrides ("solana:5,bsc:5"). Empty = uniform
# POSITION_SIZE_USD everywhere. Baseline weights Solana $5 (tail risk)
# while keeping $10 elsewhere.
CHAIN_POSITION_SIZES=solana:5

# Two-snapshot confirmation: re-quote a qualifying candidate after a short
# delay and enter only if price/liquidity aren't already deteriorating.
# Rising/flat prints always pass — not a momentum gate.
ENTRY_CONFIRM_ENABLED=true
ENTRY_CONFIRM_DELAY_MS=3000
ENTRY_CONFIRM_MAX_PRICE_DROP_PCT=5
ENTRY_CONFIRM_MAX_LIQ_DROP_PCT=30

# Never open the same chain:pair twice — closed-trade history
# (restored from STATE_FILE) guards re-entry after restarts.
ONE_ENTRY_PER_POOL=true

# Reload-safe paper trading: open positions, cash and trade history
# persist to STATE_FILE and are restored on boot.
RECOVERY_ENABLED=true
STATE_FILE=data/state.json

# DuckDB trade ledger: every fill + closed trade appended for SQL analysis.
# Best-effort — ledger failures never stop the trading loops.
ANALYTICS_ENABLED=true
DUCKDB_PATH=data/paper.duckdb

# Per-minute snapshots of open positions (price, liquidity, txn mix) into
# position_snapshots — research input for the late-gap study, never an exit.
SNAPSHOT_INTERVAL_S=60

# The paper model can add configurable entry/exit friction.
# 0 = gross PnL; change to your measured all-in assumptions.
PAPER_ENTRY_FEE_BPS=0
PAPER_EXIT_FEE_BPS=0
PAPER_SLIPPAGE_BPS=0

# ------------------------------------------------------------
# Partial take profits: gain % / % of ORIGINAL quantity sold
# ------------------------------------------------------------
TP1_PCT=30
TP1_SELL_PCT=25
TP2_PCT=60
TP2_SELL_PCT=25
TP3_PCT=100
TP3_SELL_PCT=25

# ------------------------------------------------------------
# Stops
# ------------------------------------------------------------
INITIAL_STOP_PCT=15
TRAIL_ACTIVATION_PCT=30
TRAIL_DISTANCE_PCT=20

# Dead-on-arrival exit: a position younger than EARLY_STOP_WINDOW_S that
# prints below -EARLY_STOP_PCT is exited at once instead of riding the full
# initial stop. Must stay tighter than INITIAL_STOP_PCT.
EARLY_STOP_ENABLED=true
EARLY_STOP_PCT=10
EARLY_STOP_WINDOW_S=180

# Dynamic SL: ratchet protection to breakeven (+ buffer) once gain reaches
# BREAKEVEN_ARM_PCT (or TP1 fills, as a fallback). Hierarchy with defaults:
# initial -15% -> breakeven@+20% -> TP1+trail@+30%.
BREAKEVEN_AFTER_TP1=true
BREAKEVEN_BUFFER_PCT=0
BREAKEVEN_ARM_PCT=20

# ------------------------------------------------------------
# CoinGecko (optional enrichment only — discovery stays DexPaprika)
# ------------------------------------------------------------
COINGECKO_API=

# ------------------------------------------------------------
# Execution (Stage 1; the paper engine does not use these yet)
# ------------------------------------------------------------
# Master live-spend gate (default off) + isolated trader key (never commit).
# LIVE_TRADING_ENABLED=false
# TRADER_PRIVATE_KEY=
# EVM router quotes (0x primary, Uniswap direct-V2 fallback).
# ZEROEX_API_KEY=
# Per-chain V2 router overrides (JSON); built-ins cover ethereum + bsc.
# UNISWAP_V2_ROUTERS={"robinhood":"0x..."}
# Per-chain RPCs for viem (quotes, gas, eth_call simulation).
# Optional: public read-only defaults are built in (override for reliability).
# EVM_RPC_URLS={"bsc":"https://...","robinhood":"https://..."}
# Solana execution via Jupiter Swap V2 (x-api-key header, keyless 0.5 RPS).
# JUPITER_API_KEY=
# Simulation taker address (any address; quote-only diagnostics, never spends).
# SIM_TAKER_ADDRESS=

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STARTUP_MESSAGE=true
# Only BUY + CLOSE go to Telegram by default. Set true to also
# receive candidate pings and interim TP / trailing updates.
TELEGRAM_ANNOUNCE_CANDIDATES=false
TELEGRAM_TRADE_UPDATES=false
